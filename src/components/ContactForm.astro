---
import { t } from '../i18n/index';
import type { Lang } from '../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = t(lang).form;

---

<div class="bg-[#141414] rounded-2xl border border-amber-400/25 shadow-xl shadow-amber-400/5 p-8 lg:p-10">

  <div data-cf-success hidden class="text-center py-8">
    <div class="w-16 h-16 rounded-full bg-amber-400/10 border border-amber-400/30 flex items-center justify-center mx-auto mb-5">
      <svg class="w-8 h-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="font-display font-bold text-xl text-amber-400 mb-2">{f.successTitle}</h3>
    <p class="text-neutral-300 text-sm mt-1">{f.successMsg}</p>
    <button id="reset-form" class="mt-5 text-sm text-amber-400 underline underline-offset-4 hover:text-amber-300 transition-colors">
      {f.successReset}
    </button>
  </div>

  <div data-cf-error hidden class="mb-5 text-sm text-rose-600 bg-rose-50 border border-rose-100 rounded-lg px-4 py-3">{f.errorMsg}</div>

  <form id="contact-form" data-lang={lang} data-submitting={f.submitting}>
    <div class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4">

      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-name">{f.name} <span class="text-rose-400">*</span></label>
        <input id="cf-name" name="name" type="text" required placeholder={f.namePlaceholder} class="field-input" />
      </div>

      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-email">{f.email} <span class="text-rose-400">*</span></label>
        <input id="cf-email" name="email" type="email" required placeholder={f.emailPlaceholder} class="field-input" />
      </div>

      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-checkin">{f.checkin} <span class="text-rose-400">*</span></label>
        <input id="cf-checkin" name="checkin" type="text" required readonly autocomplete="off" class="field-input cursor-pointer" />
      </div>

      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-checkout">{f.checkout} <span class="text-rose-400">*</span></label>
        <input id="cf-checkout" name="checkout" type="text" required readonly autocomplete="off" class="field-input cursor-pointer" />
      </div>

      <div class="flex flex-col gap-1 sm:col-span-2">
        <label class="field-label" for="cf-message">{f.message}</label>
        <textarea id="cf-message" name="message" rows="3" placeholder={f.messagePlaceholder} class="field-input resize-none"></textarea>
      </div>

    </div>

    <button type="submit"
      class="mt-6 w-full flex items-center justify-center gap-2 bg-amber-400 hover:bg-amber-500 text-slate-900 font-semibold text-base px-8 py-3.5 rounded-full transition-all duration-200 hover:scale-[1.02] shadow-md shadow-amber-400/30 disabled:opacity-60 disabled:cursor-not-allowed disabled:scale-100">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
      </svg>
      {f.submit}
    </button>
  </form>
</div>

<style>
  .field-label { font-size: 0.8125rem; font-weight: 600; color: #d4d4d4; }
  .field-input {
    width: 100%; border: 1px solid #404040; border-radius: 0.625rem;
    padding: 0.625rem 0.875rem; font-size: 0.9375rem; color: #f5f5f5;
    background: #1e1e1e; outline: none; transition: border-color 0.15s, box-shadow 0.15s;
    font-family: inherit;
  }
  .field-input:focus { border-color: #fbbf24; box-shadow: 0 0 0 3px rgba(251,191,36,0.12); background: #242424; }
  .field-input[aria-invalid="true"] { border-color: #f43f5e; box-shadow: 0 0 0 3px rgba(244,63,94,0.1); }
  .field-input::placeholder { color: #8a8a8a; }
  select.field-input { appearance: auto; color-scheme: dark; }
  :global(.flatpickr-day.selected),
  :global(.flatpickr-day.selected:hover),
  :global(.flatpickr-day.startRange),
  :global(.flatpickr-day.endRange) {
    background: #fbbf24; border-color: #fbbf24; color: #0a0a0a;
  }
  :global(.flatpickr-day:hover) { background: #2a2a2a; }
  :global(.flatpickr-calendar) { border: 1px solid #2a2a2a; z-index: 99999 !important; }
</style>

<script is:inline>
  // Invio della richiesta a /api/contact (Resend → email al gestore)
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var box = form.parentElement;
    var success = box.querySelector('[data-cf-success]');
    var error = box.querySelector('[data-cf-error]');
    var button = form.querySelector('button[type="submit"]');
    var label = button.innerHTML;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.reportValidity()) return;
      // I campi data sono in sola lettura (calendario): il browser non li controlla, lo facciamo qui
      var missing = Array.prototype.filter.call(form.querySelectorAll('input[required][readonly]'), function (el) { return !el.value; });
      form.querySelectorAll('input[readonly]').forEach(function (el) { el.removeAttribute('aria-invalid'); });
      if (missing.length) {
        missing.forEach(function (el) { el.setAttribute('aria-invalid', 'true'); });
        missing[0].focus();
        missing[0].click();
        return;
      }
      error.hidden = true;
      button.disabled = true;
      button.textContent = form.dataset.submitting;
      var data = Object.fromEntries(new FormData(form).entries());
      data.lang = form.dataset.lang;
      data.source = 'form';
      fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) {
          if (!r.ok) throw new Error();
          form.reset();
          form.hidden = true;
          success.hidden = false;
        })
        .catch(function () { error.hidden = false; })
        .finally(function () { button.disabled = false; button.innerHTML = label; });
    });

    var reset = document.getElementById('reset-form');
    if (reset) reset.addEventListener('click', function () { success.hidden = true; form.hidden = false; });
  })();
</script>
<script>
  import flatpickr from 'flatpickr';
  import { Italian } from 'flatpickr/dist/l10n/it.js';
  import 'flatpickr/dist/themes/dark.css';

  function initPickers() {
    const lang = document.documentElement.lang;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const locale = lang === 'it' ? Italian : 'default';

    const checkoutPicker = flatpickr('#cf-checkout', {
      minDate: today,
      dateFormat: 'd/m/Y',
      locale,
    });

    flatpickr('#cf-checkin', {
      minDate: today,
      dateFormat: 'd/m/Y',
      locale,
      onChange(dates) {
        if (dates[0]) {
          const next = new Date(dates[0]);
          next.setDate(next.getDate() + 1);
          checkoutPicker.set('minDate', next);
          if (checkoutPicker.selectedDates[0] && checkoutPicker.selectedDates[0] <= dates[0]) {
            checkoutPicker.clear();
          }
        }
      },
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPickers);
  } else {
    initPickers();
  }

  document.getElementById('reset-form')?.addEventListener('click', () => {
    initPickers();
  });
</script>
