---
import '../styles/global.css';
import type { Lang } from '../i18n/index';
import { GOOGLE_MAPS_URL, GEO, PLACE } from '../data/place';
import QuickContact from '../components/QuickContact.astro';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description = '', lang } = Astro.props;

const canonicalIt = 'https://scjavuru.holiday/';
const canonicalEn = 'https://scjavuru.holiday/en/';

const isIT = lang === 'it';

// Dati strutturati: collegano il sito alla scheda Google Maps
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: PLACE.name,
  url: isIT ? canonicalIt : canonicalEn,
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: PLACE.streetAddress,
    postalCode: PLACE.postalCode,
    addressLocality: PLACE.locality,
    addressRegion: PLACE.region,
    addressCountry: PLACE.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: GEO.lat, longitude: GEO.lon },
  hasMap: GOOGLE_MAPS_URL,
  sameAs: [GOOGLE_MAPS_URL],
};

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="it" href={canonicalIt} />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    <link rel="alternate" hreflang="x-default" href={canonicalIt} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3/dist/css/glightbox.min.css" />
  </head>
  <body class="font-sans text-slate-800 bg-white antialiased">
    <slot />
    <script is:inline src="https://cdn.jsdelivr.net/npm/glightbox@3/dist/js/glightbox.min.js"></script>

    <QuickContact lang={lang} />
  </body>
</html>
